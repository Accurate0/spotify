{
  "src": "./src",
  "language": "typescript",
  "schema": "./graph.graphql",
  "excludes": [
    "**/node_modules/**",
    "**/__mocks__/**",
    "**/__generated__/**"
  ],
  "eagerEsModules": true,
  "customScalarTypes": {
    "DateTime": "string",
    "Upload": "unknown",
    "NaiveDate": "string"
  },
  "persistConfig": {
    "file": "./persisted-documents.json",
    "algorithm": "SHA256",
    "include_query_text": true
  }
}
