{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>anurag/k8s//platform-services/renovate/presets/default"
  ],
  "packageRules": [
    {
      "description": "These crates must agree on one opentelemetry version, or the propagator and tracer they share are different globals and spans fall out of the supergraph's traces.",
      "matchDatasources": ["crate"],
      "matchPackageNames": [
        "opentelemetry",
        "opentelemetry_sdk",
        "opentelemetry-otlp",
        "opentelemetry-semantic-conventions",
        "tracing-opentelemetry",
        "axum-tracing-opentelemetry",
        "reqwest-tracing"
      ],
      "groupName": "opentelemetry",
      "commitMessageTopic": "opentelemetry"
    }
  ]
}
